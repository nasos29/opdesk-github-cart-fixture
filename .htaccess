# === OPDESK-TEST-FIXTURE BEGIN (inert) — simulated spam/cloaked redirect ===
# Harmless: only visitors arriving from a search engine are 302'd to example.com.
# Normal visitors (no Referer) are NOT affected, so the site still returns 200.
# Detected by src/lib/compromise.ts scanHtaccess() (suspicious_htaccess).
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_REFERER} (google|bing|yahoo|yandex)\. [NC]
RewriteRule ^(.*)$ https://example.com/opdesk-test-redirect [R=302,L]
</IfModule>
# === OPDESK-TEST-FIXTURE END ===
